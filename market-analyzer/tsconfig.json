{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["es2023", "dom"],
		"types": ["node"],
		"typeRoots": ["../node_modules/@types"],
		"skipLibCheck": true,
		"strict": true,
		"noEmit": true,
		"esModuleInterop": true,
		"module": "esnext",
		"moduleResolution": "bundler",
		"resolveJsonModule": true,
		"isolatedModules": true,
		"paths": {
			"@/*": ["../src/*"]
		}
	},
	"include": ["src/**/*.ts"]
}
