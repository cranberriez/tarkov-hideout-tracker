# Copy to .env next to compose.yml. Only DATABASE_URL is required.
DATABASE_URL=postgresql://user:password@host/tarkov?sslmode=require
# A database on the Docker host (localhost inside the container is the container itself):
# DATABASE_URL=postgresql://user:password@host.docker.internal:5555/tarkov
PG_POOL_MAX=4

# Log style: json (one JSON object per event, default) or pretty (one readable line per
# event; errors add indented detail lines).
# MARKET_LOG_FORMAT=pretty
# PG_STATEMENT_TIMEOUT_MS=30000

# Modes, in priority order (Seasonal is always handled first).
# MARKET_MODES=pvp-season,regular,pve
# MARKET_CONCURRENCY=12

# Seasonal: near-live conditional polling, pushed hourly, analysed every 12 h.
# MARKET_SEASON_POLL_MINUTES=30
# MARKET_SEASON_CATALOG_MINUTES=360
# MARKET_SEASON_ANALYSIS_HOURS=12

# Regular PvP and PvE (mature economies).
# MARKET_MATURE_POLL_MINUTES=360
# MARKET_MATURE_CATALOG_MINUTES=360
# MARKET_MATURE_ANALYSIS_HOURS=24

# MARKET_FLUSH_MINUTES=60

# Run steps immediately at start-up, e.g. pvp-season:analyze, regular, all:reanalyze.
# MARKET_RUN_ON_START=pvp-season:analyze
# MARKET_ELIGIBLE_REFRESH_HOURS=6
