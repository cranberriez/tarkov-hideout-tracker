{
	"name": "tarkov-hideout-tracker",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"lint": "eslint",
		"docs:check": "node scripts/check-doc-links.mjs",
		"test:architecture": "node --test --import jiti/register src/architecture/data-import-boundaries.test.ts",
		"test:theme": "node --test --import jiti/register src/architecture/theme-colors.test.ts",
		"test:contracts": "node --test --import jiti/register src/server/queries/page-data-queries.test.ts src/server/queries/shared-data-queries.test.ts src/server/queries/item-detail-queries.test.ts src/server/queries/getKappaChecklistPageData.test.ts src/server/queries/searchItems.test.ts",
		"test:query": "node --test --experimental-test-isolation=none --import jiti/register src/lib/query/query-foundation.test.ts",
		"test:search": "node --test --experimental-test-isolation=none --import jiti/register src/features/search/search-model.test.ts src/lib/search/manifest.test.ts src/server/db/search-manifest.test.ts src/server/queries/searchItems.test.ts",
		"test:page-data": "node --test --experimental-test-isolation=none --import jiti/register src/lib/query/page-data.test.ts src/server/queries/prefetchPageData.test.ts",
		"test:reusable-reads": "node --test --experimental-test-isolation=none --import jiti/register src/lib/query/reusable-reads.test.ts",
		"db:generate": "node db-scripts/generate.mjs",
		"db:validate": "node db-scripts/validate.mjs",
		"db:upload": "node db-scripts/upload.mjs",
		"db:compact": "node db-scripts/compact.mjs",
		"db:status": "node db-scripts/status.mjs",
		"db:storage": "node db-scripts/storage-stats.mjs",
		"db:prices:init": "node db-scripts/init-price-storage.mjs",
		"db:prices:refresh": "node db-scripts/refresh-prices.mjs",
		"pull-map-overlays": "node scripts/pull-map-overlays.mjs",
		"quest-series-candidates": "node scripts/generate-quest-series-candidates.mjs",
		"quest-data-compare": "node scripts/compare-quest-data.mjs",
		"db:catalog:init": "node db-scripts/init-catalog.mjs",
		"db:items:check": "node db-scripts/check-new-items.mjs",
		"db:update": "node db-scripts/update.mjs"
	},
	"dependencies": {
		"@floating-ui/react-dom": "^2.1.6",
		"@libsql/client": "^0.18.0",
		"@radix-ui/react-dialog": "^1.1.15",
		"@radix-ui/react-dropdown-menu": "^2.1.16",
		"@tanstack/react-query": "^5.102.8",
		"@tanstack/react-query-devtools": "^5.102.8",
		"@tanstack/react-virtual": "^3.13.24",
		"@vercel/analytics": "^1.5.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"lucide-react": "^0.554.0",
		"next": "16.3.3",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"server-only": "^0.0.1",
		"tailwind-merge": "^3.4.0",
		"zustand": "^5.0.8"
	},
	"devDependencies": {
		"@tailwindcss/postcss": "^4",
		"@types/node": "^20",
		"@types/react": "19.2.18",
		"@types/react-dom": "19.2.5",
		"eslint": "^9",
		"eslint-config-next": "16.3.3",
		"jiti": "^2.7.0",
		"markdown-link-check": "^3.15.0",
		"prettier": "^3.9.6",
		"tailwindcss": "^4",
		"tw-animate-css": "^1.4.0",
		"typescript": "^5"
	}
}
