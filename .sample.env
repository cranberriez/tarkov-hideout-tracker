# Turso is used by both the offline db-scripts pipeline and runtime data reads.
# Runtime release IDs are pinned in src/server/db/release-config.ts.
TURSO_DATABASE_URL="libsql://your-database.turso.io"
TURSO_AUTH_TOKEN="your-turso-auth-token"

# Protects Vercel price-refresh cron routes. Use a random value of at least 16 characters.
CRON_SECRET="replace-with-a-random-secret"
