KV_REST_API_READ_ONLY_TOKEN="abcd"
KV_REST_API_TOKEN="abcd"
KV_REST_API_URL="https://something.upstash.io"

# Legacy development-only master switch. Prefer the operation flags below.
CACHE_ENABLED="true"

# Optional global operation overrides. When set, these override every
# dataset-specific flag. Omit a value to use per-dataset settings/defaults.
# CACHE_NEXT_ENABLED="true"
# CACHE_REDIS_READ_ENABLED="true"
# CACHE_REDIS_WRITE_ENABLED="true"

# Dataset-specific examples. Full and lightweight quest Redis writes default to
# false in development when neither a global nor dataset override is supplied.
# CACHE_QUESTS_NEXT_ENABLED="true"
# CACHE_QUESTS_REDIS_READ_ENABLED="true"
# CACHE_QUESTS_REDIS_WRITE_ENABLED="false"
# CACHE_QUESTS_FULL_NEXT_ENABLED="true"
# CACHE_QUESTS_FULL_REDIS_READ_ENABLED="true"
# CACHE_QUESTS_FULL_REDIS_WRITE_ENABLED="false"
KV_URL="rediss://default:abc@something.upstash.io:6379"
REDIS_URL="rediss://default:abc@something.upstash.io:6379"

CRON_SECRET="abcd1234"
TARKOV_DATA_SOURCE=json

# Turso is used by the offline db-scripts ingestion pipeline. Runtime reads will
# be wired separately after generated releases have been verified.
TURSO_DATABASE_URL="libsql://your-database.turso.io"
TURSO_AUTH_TOKEN="your-turso-auth-token"
