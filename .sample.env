# PostgreSQL runtime/catalog/price connection. Use your provider's verified TLS settings.
DATABASE_URL="postgresql://user:password@localhost:5432/tarkov"
# Optional direct connection for migrations when DATABASE_URL uses a transaction pooler.
DATABASE_MIGRATION_URL=""
PG_POOL_MAX="10"
PG_STATEMENT_TIMEOUT_MS="30000"
# Only a separate disposable database may be used for integration tests.
TEST_DATABASE_URL=""

# Optional, one-time direct discovery export only; not used by the PostgreSQL app.
# TURSO_DATABASE_URL="libsql://your-source-database.turso.io"
# TURSO_AUTH_TOKEN="your-source-database-token"

# Protects the Vercel catalog-update cron route. Use a random value of at least 16 characters.
CRON_SECRET="replace-with-a-random-secret"
